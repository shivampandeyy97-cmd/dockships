# ==============================================================================
# DOCKSHIPS BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

PORT=4001
DATABASE_PATH=./dockships.db

# ------------------------------------------------------------------------------
# WEBSITE TRAFFIC INTELLIGENCE (Free Tier API Keys & Fallback Tokens)
# ------------------------------------------------------------------------------
# 1. SimilarWeb Official API Key (Optional)
#    Get free trial API key from: https://www.similarweb.com/corp/developer/
#    If empty, the system automatically uses SimilarWeb free public endpoints.
SIMILARWEB_API_KEY=

# 2. RapidAPI Key (Optional)
#    Get free key from: https://rapidapi.com/hub (search "SimilarWeb Traffic")
#    Free tier grants several hundred lookups/month.
RAPIDAPI_KEY=
RAPIDAPI_HOST=similarweb-v1.p.rapidapi.com

# 3. Cloudflare Radar API Token (Optional / Free)
#    Get free token from: https://dash.cloudflare.com/profile/api-tokens
#    Used for global domain ranking & traffic distribution signals.
CLOUDFLARE_API_TOKEN=
